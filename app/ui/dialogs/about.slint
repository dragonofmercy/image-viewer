import { Theme } from "../theme.slint";
import { Tr } from "../tr.slint";
import { AccentButton, Button } from "../widgets/button.slint";
import { HyperlinkButton } from "../widgets/hyperlink-button.slint";
import { InfoBar } from "../widgets/info-bar.slint";
import { ProgressRing } from "../widgets/progress-ring.slint";
import { SettingsCard } from "../widgets/settings-card.slint";
import { ContentDialog } from "content-dialog.slint";

// Texts and update state of the About dialog, filled and handled by options.rs and main.rs (`open-url(true)` is the releases page).
// update-state: 0 idle, 1 checking, 2 up to date, 3 available, 4 downloading, 5 failed. `error` is empty for a network failure.
export global AboutState {
    in property <string> version;
    in property <string> last-check;
    in property <int> update-state;
    in property <int> progress;
    in property <string> error;
    in property <bool> failed-download;
    callback open-url(bool);
    callback check();
    callback download();
    // The dialog was closed (by any means).
    callback closed();
}

export component AboutDialog inherits ContentDialog {
    VerticalLayout {
        padding: 24px;
        // ContentDialogHeadingMargin 0,0,0,16
        HorizontalLayout {
            padding-bottom: 16px;
            spacing: 20px;
            Image {
                width: 96px;
                height: 96px;
                source: @image-url("../../assets/ImageViewer.ico");
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Image Viewer";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "By DragonOfMercy";
                    color: Theme.text-primary;
                    font-size: 12px;
                }
                HorizontalLayout {
                    padding-top: 5px;
                    // 1.x: the first link is pulled 12px left (the button padding), the second sits 20px after it.
                    padding-left: -12px;
                    spacing: 20px;
                    alignment: start;
                    HyperlinkButton {
                        font-weight: 700;
                        font-size: 13px;
                        text: Tr.t("ABOUT_LINK_GITHUB_REPOSITORY");
                        clicked => {
                            AboutState.open-url(false);
                        }
                    }
                    HyperlinkButton {
                        font-weight: 700;
                        font-size: 13px;
                        text: Tr.t("ABOUT_LINK_LATEST_RELEASE");
                        clicked => {
                            AboutState.open-url(true);
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                padding-top: 5px;
                HyperlinkButton {
                    width: 44px;
                    glyph: "\u{E711}";
                    foreground: Theme.text-primary;
                    clicked => {
                        root.close();
                    }
                }
            }
        }
        SettingsCard {
            glyph: "\u{E895}";
            label: AboutState.version;
            description: AboutState.last-check;
            HorizontalLayout {
                spacing: 16px;
                if AboutState.update-state == 1: VerticalLayout {
                    alignment: center;
                    ProgressRing {
                        width: 20px;
                        height: 20px;
                    }
                }
                if AboutState.update-state == 1: VerticalLayout {
                    alignment: center;
                    Text {
                        text: Tr.t("ABOUT_UPDATE_CHECKING");
                        color: Theme.text-primary;
                    }
                }
                if AboutState.update-state != 1: Button {
                    text: Tr.t("ABOUT_BTN_CHECK_UPDATE");
                    enabled: AboutState.update-state != 4;
                    clicked => {
                        AboutState.check();
                    }
                }
            }
        }
        VerticalLayout {
            padding-top: 4px;
            InfoBar {
                open: AboutState.update-state >= 2;
                severity: AboutState.update-state == 2 ? 1 : AboutState.update-state == 5 ? 3 : 2;
                title: AboutState.update-state == 2 ? Tr.t("ABOUT_UPDATE_INFO_UPDATE_LATEST")
                    : AboutState.update-state == 5 ? (AboutState.error != "" ? AboutState.error : Tr.t("ABOUT_UPDATE_INFO_ERROR_NO_INTERNET"))
                    : Tr.t("ABOUT_UPDATE_INFO_UPDATE_AVAILABLE");
                if AboutState.update-state == 3 || AboutState.update-state == 4 || (AboutState.update-state == 5 && AboutState.failed-download): AccentButton {
                    text: AboutState.update-state == 4 ? Tr.t("ABOUT_BTN_DOWNLOAD_UPDATE_DOWNLOADING") + " " + AboutState.progress + "%"
                        : AboutState.update-state == 5 ? Tr.t("ABOUT_BTN_DOWNLOAD_UPDATE_RETRY")
                        : Tr.t("ABOUT_BTN_DOWNLOAD_UPDATE");
                    enabled: AboutState.update-state != 4;
                    clicked => {
                        AboutState.download();
                    }
                }
            }
        }
        // Reports the close to Rust: a `changed open` here would replace the one of ContentDialog.
        Rectangle {
            width: 0px;
            height: 0px;
            property <bool> shown: root.open;
            changed shown => {
                if !self.shown {
                    AboutState.closed();
                }
            }
        }
    }
}
