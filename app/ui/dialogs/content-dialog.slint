import { Theme } from "../theme.slint";
import { FocusReturn } from "../widgets/menu-flyout.slint";
import { PopupArea } from "../widgets/combo-box.slint";

// In-window modal host, the WinUI ContentDialog with the 1.x App.xaml sizes (ContentDialogPadding 0, min width 744px, max width 1280px).
// Place it last in the window, filling it. Showing one dialog at a time is the caller's rule. Escape closes it.
// The smoke covers the whole window; the native hit-test keeps the caption buttons and the caption drag working over it.
export component ContentDialog inherits Rectangle {
    in-out property <bool> open;
    // WinUI default button: Enter closes a dialog whose only command is Close.
    in property <bool> close-on-enter: false;
    callback closed;

    public function close() {
        root.open = false;
        root.closed();
    }

    // Gives the keyboard (back) to the dialog.
    public function focus-keys() {
        keys.focus();
    }

    visible: root.open;

    changed open => {
        if root.open {
            keys.focus();
        } else {
            // The dialog content is destroyed with a dropdown possibly open, whose own reset never runs.
            PopupArea.open = false;
            FocusReturn.token += 1;
        }
    }

    Rectangle {
        background: Theme.smoke;
    }
    // Swallows pointer and wheel events over the content and the footer.
    TouchArea {
        scroll-event(event) => {
            EventResult.accept
        }
    }

    // Keys of the content bubble up here and stop: none reaches the window shortcuts.
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || (root.close-on-enter && event.text == Key.Return) {
                root.close();
            }
            // Tab and Shift+Tab belong to Slint's focus navigation among the dialog controls.
            if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            accept
        }

        // WinUI dialog elevation. On its own rectangle: the card clips its content.
        Rectangle {
            x: card.x;
            y: card.y;
            width: card.width;
            height: card.height;
            border-radius: Theme.overlay-radius;
            background: Theme.window-background;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: Theme.dialog-shadow;
        }
        card := Rectangle {
            width: min(max(744px, min(1280px, content.preferred-width)), root.width - 48px);
            height: min(max(64px, content.preferred-height), root.height - 48px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.window-background;
            border-width: 1px;
            border-color: Theme.dialog-stroke;
            border-radius: Theme.overlay-radius;
            clip: true;
            // Clicks on the card do not fall through to the smoke.
            TouchArea { }
            content := VerticalLayout {
                @children
            }
        }
    }
}
