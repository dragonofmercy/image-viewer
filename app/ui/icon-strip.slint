import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { Icon } from "widgets/icon.slint";
import { ToolTip } from "widgets/tooltip.slint";

export struct IconSizeItem {
    thumb: image,
    label: string,
    tooltip: string,
}

// Step button of the strip (XAML Button 22x52, no tooltip, accessible name only).
component StepButton inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    callback clicked;
    width: 22px;
    height: 52px;
    border-radius: Theme.control-radius;
    background: touch.pressed ? Theme.subtle-fill-tertiary : touch.has-hover ? Theme.subtle-fill-secondary : transparent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        glyph: root.glyph;
        size: 14px;
        tint: Theme.text-primary;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Icon size picker (XAML IconSizeBar): the parent places it; it is 52px of content plus 4px padding and the 1px border on each side.
export component IconStrip inherits Rectangle {
    in property <[IconSizeItem]> sizes;
    in property <int> selected;
    // Room the parent leaves for the strip (its width minus the 16px margins).
    in property <length> available;
    callback choose(int);
    callback step(int);

    // Item container: 40px content + 6px padding each side, 2px margin each side.
    property <length> item-pitch: 40px + 12px + 4px;
    // Padding 4px + border 1px on each side, two step buttons, two 2px gaps around the list.
    property <length> chrome: 2 * 5px + 2 * 22px + 2 * 2px;

    // Keeps the selected item inside the list: the step buttons can select an item that is scrolled out.
    function reveal() {
        if (root.selected < 0) {
            return;
        }
        flick.content-x = max(min(flick.content-x, -root.selected * root.item-pitch), flick.width - (root.selected + 1) * root.item-pitch);
    }
    changed selected => {
        root.reveal();
    }
    init => {
        root.reveal();
    }

    width: max(0px, min(min(640px, root.available), root.chrome + root.sizes.length * root.item-pitch));
    height: 52px + 2 * 5px;
    border-radius: Theme.overlay-radius;
    background: Theme.pane-background;
    border-width: 1px;
    border-color: Theme.app-bar-border;

    // Swallows what the items and buttons do not take (gaps, padding, drags, wheel) so it never reaches the image view; the wheel scrolls the list.
    TouchArea {
        scroll-event(event) => {
            flick.content-x = max(min(0px, flick.width - root.sizes.length * root.item-pitch), min(0px, flick.content-x + (event.delta-y + event.delta-x)));
            EventResult.accept
        }
    }

    HorizontalLayout {
        padding: 5px;
        spacing: 2px;
        StepButton {
            glyph: "\u{E76B}";
            name: Tr.t("ICON_SIZE_LARGER");
            clicked => {
                root.step(-1);
            }
        }
        flick := Flickable {
            content-width: root.sizes.length * root.item-pitch;
            for item[i] in root.sizes: Rectangle {
                x: i * root.item-pitch + 2px;
                y: 0px;
                width: 40px + 12px;
                height: 52px;
                border-radius: Theme.control-radius;
                background: touch.pressed ? (i == root.selected ? Theme.subtle-fill-secondary : Theme.subtle-fill-tertiary) : touch.has-hover ? (i == root.selected ? Theme.subtle-fill-tertiary : Theme.subtle-fill-secondary) : i == root.selected ? Theme.subtle-fill-secondary : transparent;
                VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    // Fixed-height box so every thumbnail shares a baseline; the frame is capped at 32px and never upscaled.
                    Rectangle {
                        height: 32px;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: item.thumb;
                            width: min(32px, self.source.width * 1px);
                            height: min(32px, self.source.height * 1px);
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: item.label;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
                touch := TouchArea {
                    clicked => {
                        root.choose(i);
                    }
                }
                ToolTip {
                    text: item.tooltip;
                }
            }
        }
        StepButton {
            glyph: "\u{E76C}";
            name: Tr.t("ICON_SIZE_SMALLER");
            clicked => {
                root.step(1);
            }
        }
    }
}
