import "../assets/SegoeIcons.ttf";
import { Theme } from "theme.slint";

// No TouchArea: the OS sends non-client messages over the button (HTMINBUTTON etc.), so hover and press state come from Rust.
component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> hover;
    in property <bool> pressed;
    in property <bool> is-close;
    width: 46px;
    height: 48px;
    background: root.is-close ? (root.pressed ? #c42b1ce6 : root.hover ? #c42b1c : transparent) : (root.pressed ? Theme.title-button-pressed : root.hover ? Theme.title-button-hover : transparent);
    Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: Theme.text-primary;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title-text;
    in property <bool> maximized;
    // 0 = none, 1 = minimize, 2 = maximize, 3 = close
    in property <int> caption-hover;
    in property <int> caption-pressed;
    background: Theme.app-bar-background;

    VerticalLayout {
        HorizontalLayout {
            VerticalLayout {
                alignment: center;
                padding-left: 16px;
                padding-right: 16px;
                Image {
                    source: @image-url("../assets/ImageViewer.ico");
                    width: 16px;
                    height: 16px;
                }
            }
            Text {
                text: root.title-text;
                font-size: 12px;
                color: Theme.text-primary;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            // Same 144px column as the 1.x XAML; the buttons are overlaid below.
            Rectangle { width: 144px; }
        }
        Rectangle {
            height: 1px;
            background: Theme.app-bar-border;
        }
    }

    // Full title bar height, drawn over the bottom border like the 1.x system caption buttons.
    HorizontalLayout {
        x: root.width - self.width;
        width: 3 * 46px;
        height: 48px;
        y: 0px;
        CaptionButton { glyph: "\u{E921}"; hover: root.caption-hover == 1; pressed: root.caption-pressed == 1; }
        CaptionButton { glyph: root.maximized ? "\u{E923}" : "\u{E922}"; hover: root.caption-hover == 2; pressed: root.caption-pressed == 2; }
        CaptionButton { glyph: "\u{E8BB}"; hover: root.caption-hover == 3; pressed: root.caption-pressed == 3; is-close: true; }
    }
}
