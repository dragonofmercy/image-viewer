import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

// Usage: declare the flyout inside its anchor (an AppBarButton accepts it as a child) and open it from the anchor.
//
//     AppBarButton {
//         glyph: "\u{E700}";
//         clicked => { flyout.show(); }
//         flyout := MenuFlyout {
//             MenuItem { text: Tr.t("KEY"); shortcut-text: "Ctrl+O"; enabled: root.can-open; clicked => { root.open(); } }
//             MenuSeparator { }
//         }
//     }
//
// Items inside the popup cannot be addressed by id from outside it: bind `enabled` to properties or globals.
// Each enabled item closes the menu after its `clicked`; clicking a disabled item or a separator keeps it open; a click outside closes it.
global MenuControl {
    in-out property <int> close-token;
}

// Bumped each time a flyout closes; the root window watches it to take the keyboard focus back.
export global FocusReturn {
    in-out property <int> token;
}

export component MenuSeparator inherits Rectangle {
    // WinUI: 1px line with 1px padding above and below; the 2px item margins supply the rest of the gap.
    height: 3px;
    Rectangle {
        y: 1px;
        height: 1px;
        background: Theme.menu-separator;
    }
}

export component MenuItem inherits Rectangle {
    in property <string> glyph;
    in property <string> path-data;
    in property <float> viewbox-width: 16;
    in property <float> viewbox-height: 16;
    in property <string> text;
    in property <string> shortcut-text;
    in property <bool> enabled: true;
    callback clicked;

    // WinUI mouse-invoked metrics: 29px highlighted row (narrow padding) inside a 4px side / 2px vertical margin.
    height: 33px;
    min-width: 200px;

    Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        border-radius: Theme.control-radius;
        background: !root.enabled ? transparent : touch.pressed ? Theme.subtle-fill-tertiary : touch.has-hover ? Theme.subtle-fill-secondary : transparent;
    }

    HorizontalLayout {
        padding-left: 4px + 12px;
        padding-right: 4px + 12px;
        spacing: 12px;
        Rectangle {
            width: 16px;
            Icon {
                glyph: root.glyph;
                path-data: root.path-data;
                viewbox-width: root.viewbox-width;
                viewbox-height: root.viewbox-height;
                size: 16px;
                tint: root.enabled ? Theme.text-primary : Theme.text-disabled;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.shortcut-text;
            font-size: 12px;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
            MenuControl.close-token += 1;
        }
    }
}

// Place it inside the anchor (it fills it) and call `show()`; the popup opens above the anchor.
// Children are MenuItem / MenuSeparator rows.
export component MenuFlyout inherits Rectangle {
    // Right edges aligned (TopEdgeAlignedRight); otherwise left edges aligned (TopEdgeAlignedLeft).
    in property <bool> align-right: false;

    property <int> close-request: MenuControl.close-token;
    changed close-request => {
        popup.close();
    }

    changed popup-open => {
        if !root.popup-open {
            FocusReturn.token += 1;
        }
    }
    property <bool> popup-open: popup.is-open;

    public function show() {
        popup.show();
    }

    public function close() {
        popup.close();
    }

    popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: root.align-right ? root.width - self.width : 0px;
        y: -self.height - 8px;
        Rectangle {
            background: Theme.combo-dropdown-background;
            border-width: 1px;
            border-color: Theme.surface-stroke-flyout;
            border-radius: Theme.overlay-radius;
            VerticalLayout {
                padding-top: 2px + 1px;
                padding-bottom: 2px + 1px;
                padding-left: 1px;
                padding-right: 1px;
                @children
            }
        }
    }
}
