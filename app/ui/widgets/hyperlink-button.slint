import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

// Content is `text`, or `glyph` (font icon) when set.
export component HyperlinkButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <color> foreground: Theme.accent;
    in property <bool> enabled: true;
    in property <int> font-weight: 400;
    in property <length> font-size: 14px;
    callback clicked;

    min-height: 32px;
    border-radius: Theme.control-radius;
    background: Theme.subtle-fill(root.enabled, touch.pressed, touch.has-hover);

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: center;
        if root.glyph != "": VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 16px;
                tint: root.enabled ? root.foreground : Theme.text-disabled;
            }
        }
        if root.glyph == "": Text {
            text: root.text;
            font-weight: root.font-weight;
            font-size: root.font-size;
            vertical-alignment: center;
            color: root.enabled ? root.foreground : Theme.text-disabled;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}
