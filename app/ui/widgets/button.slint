import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

component ButtonBase inherits Rectangle {
    in property <string> text;
    // Optional 16px glyph before the text (an icon-only button leaves `text` empty).
    in property <string> glyph;
    in property <bool> enabled: true;
    in property <bool> accent: false;
    callback clicked;

    min-height: 32px;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: root.accent ? transparent : Theme.control-stroke;
    background: root.accent ? (!root.enabled ? Theme.accent.with-alpha(0.37) : touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (!root.enabled ? Theme.control-fill : touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    accessible-role: button;
    // An icon-only button sets its own label.
    accessible-label: root.text;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: center;
        if root.glyph != "": Icon {
            glyph: root.glyph;
            size: 16px;
            tint: !root.enabled ? Theme.text-disabled : root.accent ? Theme.text-on-accent : Theme.text-primary;
        }
        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-disabled : root.accent ? Theme.text-on-accent : Theme.text-primary;
        }
    }

    // Tab reaches the button; Enter or Space activates it. A click does not focus it.
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    if fs.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: Theme.control-radius + 3px;
        border-width: 2px;
        border-color: Theme.text-primary;
    }
}

export component Button inherits ButtonBase {
    accent: false;
}

export component AccentButton inherits ButtonBase {
    accent: true;
}
