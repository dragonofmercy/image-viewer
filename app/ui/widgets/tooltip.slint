import { Theme } from "../theme.slint";

// Place it inside the target (it fills it); the built-in Tooltip shows after its fixed delay while the pointer rests on the target, is input-transparent and follows the pointer.
// An empty `text` shows nothing. Not usable as a direct child of a layout: put it in a Rectangle.
export component ToolTip inherits Rectangle {
    in property <string> text;

    if root.text != "": Tooltip {
        Rectangle {
            background: Theme.pane-background;
            border-width: 1px;
            border-color: Theme.surface-stroke-flyout;
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 8px + 1px;
                padding-right: 8px + 1px;
                padding-top: 5px + 1px;
                padding-bottom: 5px + 1px;
                Text {
                    text: root.text;
                    color: Theme.text-primary;
                    font-size: 12px;
                    wrap: no-wrap;
                }
            }
        }
    }
}
