import { TitleBar, CaptionButtons } from "titlebar.slint";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { FocusReturn } from "widgets/menu-flyout.slint";
import { ProgressRing } from "widgets/progress-ring.slint";
import { Icon } from "widgets/icon.slint";
import { Footer, Commands, AppState } from "footer.slint";
import { ImageView } from "image-view.slint";
import { IconStrip, IconSizeItem } from "icon-strip.slint";
import { InfoPane, InfoFields } from "info-pane.slint";
import { ErrorDialog } from "dialogs/error.slint";
import { Cropper } from "cropper.slint";
import { PopupArea } from "widgets/combo-box.slint";
import { SettingsDialog, SettingsState } from "dialogs/settings.slint";
import { AboutDialog, AboutState } from "dialogs/about.slint";
import { Palette } from "std-widgets.slint";

export { Theme } from "theme.slint";
export { Tr } from "tr.slint";
export { Commands, AppState } from "footer.slint";
export { IconSizeItem } from "icon-strip.slint";
export { InfoFields } from "info-pane.slint";
export { CropLayout } from "cropper.slint";
export { SettingsState } from "dialogs/settings.slint";
export { AboutState } from "dialogs/about.slint";

export component MainWindow inherits Window {
    in property <string> title-text;
    // `maximized` is the builtin Window property (in-out), kept in sync with the native state by the winit backend.
    in property <bool> window-active: true;
    // 0 = none, 1 = minimize, 2 = maximize, 3 = close; driven by the frame subclass.
    in property <int> caption-hover;
    in property <int> caption-pressed;
    // Read by the native hit-test in frame.rs.
    out property <length> title-bar-height: 48px;
    out property <length> caption-buttons-width: 3 * 46px;
    // Image area, driven by image_host.rs.
    in property <image> view-source;
    in property <length> view-x;
    in property <length> view-y;
    in property <length> view-w;
    in property <length> view-h;
    in property <bool> view-smooth: true;
    out property <length> view-width: image-view.width;
    out property <length> view-height: image-view.height;
    callback view-wheel(float, length, length);
    callback view-drag(length, length);
    callback view-resized();
    // Document state, driven by controller.rs.
    in property <bool> loading;
    in property <bool> error-visible;
    in property <string> error-file;
    in property <[IconSizeItem]> icon-sizes;
    in property <int> icon-index;
    // Pure Rust arithmetic of the strip scroll (document.rs `reveal_offset`).
    pure callback icon-reveal-offset(length, int, int, length, length) -> length;
    callback icon-size-chosen(int);
    callback icon-size-step(int);
    in property <InfoFields> info;
    callback info-folder-clicked();
    // Inline cropper, driven by controller.rs: the selection is in image pixels, drags come back in view px from their start.
    in property <bool> cropping;
    in property <float> crop-image-width;
    in property <float> crop-x;
    in property <float> crop-y;
    in property <float> crop-w;
    in property <float> crop-h;
    in property <[string]> crop-ratios;
    in-out property <int> crop-ratio-index;
    callback crop-drag-start(int);
    callback crop-drag-move(length, length);
    callback crop-ratio-chosen(int);
    callback crop-reset();
    callback crop-cancel();
    callback crop-apply();
    // The last open dialog closed: the controller shows an error that was raised behind it.
    callback dialog-closed();
    // `ShowErrorAsync`, driven by controller.rs.
    in-out property <bool> error-open;
    in property <string> error-message;
    // Settings and About, opened by options.rs.
    in-out property <bool> settings-open;
    in-out property <bool> about-open;
    // A dialog is up: a new one is dropped (later dialogs join this expression).
    out property <bool> dialog-open: root.error-open || root.settings-open || root.about-open;

    title: root.title-text;
    icon: @image-url("../assets/ImageViewer.ico");
    preferred-width: 1280px;
    preferred-height: 768px;
    background: Theme.window-background;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    // Where the keyboard belongs: the open dialog, else the window. The window scope is an ancestor of the dialogs, so focusing it
    // under a dialog would let keys bypass the dialog's own scope.
    function restore-focus() {
        if root.error-open {
            error-dialog.focus-keys();
        } else if root.settings-open {
            settings-dialog.focus-keys();
        } else if root.about-open {
            about-dialog.focus-keys();
        } else {
            scope.focus();
        }
    }

    property <int> focus-return: FocusReturn.token;
    changed focus-return => {
        root.restore-focus();
    }
    // The cropper is destroyed with the focus (and possibly an open dropdown) inside: take both back.
    changed cropping => {
        if !root.cropping {
            PopupArea.open = false;
            root.restore-focus();
        }
    }
    // Texts and inputs without an explicit color take the std palette: keep it on the app theme, not the system one.
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        PopupArea.height = self.height;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dialog-open => {
        if !root.dialog-open {
            root.dialog-closed();
        }
    }
    changed height => {
        PopupArea.height = self.height;
    }

    scope := FocusScope {
        focus-on-tab-navigation: !root.dialog-open;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // Ctrl+Shift+S may report an upper-case letter.
            let key = event.text.to-lowercase();
            let ctrl = event.modifiers.control;
            let alt = event.modifiers.alt;
            let shift = event.modifiers.shift;
            let plain = !ctrl && !alt;
            // Named keys have no modifier in the XAML accelerators, so Shift must not be held either.
            let bare = plain && !shift;
            let img = AppState.image-commands;
            // Defence in depth: the dialogs take every key themselves, one that still reaches the window runs nothing under them.
            if root.dialog-open {
                if event.text != Key.Escape {
                    return reject;
                }
                if root.error-open {
                    error-dialog.close();
                } else if root.settings-open {
                    settings-dialog.close();
                } else {
                    about-dialog.close();
                }
                return accept;
            }
            // A dropdown left without the keyboard: Enter does nothing and Escape, rejected, makes Slint close the popup.
            if PopupArea.open && (event.text == Key.Return || event.text == Key.Escape) {
                return reject;
            }
            // Only reached when no control took Enter (a focused button or combo box handles it first).
            if root.cropping && bare && event.text == Key.Return {
                root.crop-apply();
            } else if ctrl && !alt && !shift && key == "o" {
                if AppState.open { Commands.open(); }
            } else if bare && !root.cropping && event.text == Key.F10 {
                Commands.settings();
            } else if ctrl && !alt && !shift && key == "i" {
                if AppState.file-info { Commands.file-info(); }
            } else if ctrl && !alt && !shift && key == "s" {
                if AppState.save-direct { Commands.save(); }
            } else if ctrl && !alt && shift && key == "s" {
                if img { Commands.save-as(); }
            } else if ctrl && !alt && !shift && key == "p" {
                if img { Commands.print(); }
            } else if ctrl && !alt && !shift && key == "q" {
                Commands.quit();
            } else if ctrl && !alt && !shift && event.text == Key.F1 {
                Commands.about();
            } else if ctrl && !alt && !shift && key == "c" {
                Commands.copy();
            } else if ctrl && !alt && !shift && key == "v" {
                Commands.paste();
            } else if ctrl && !alt && !shift && key == "0" {
                if img && AppState.show-adjust { Commands.adjust(); }
            } else if ctrl && !alt && !shift && key == "1" {
                if img && !AppState.show-adjust { Commands.zoom-full(); }
            } else if alt && !ctrl && !shift && key == "c" {
                if img { Commands.crop(); }
            } else if alt && !ctrl && !shift && key == "h" {
                if img { Commands.flip-horizontal(); }
            } else if alt && !ctrl && !shift && key == "v" {
                if img { Commands.flip-vertical(); }
            } else if alt && !ctrl && !shift && event.text == Key.LeftArrow {
                if img { Commands.rotate-left(); }
            } else if alt && !ctrl && !shift && event.text == Key.RightArrow {
                if img { Commands.rotate-right(); }
            } else if bare && event.text == Key.Delete {
                if img { Commands.delete(); }
            } else if bare && event.text == Key.Escape {
                Commands.escape();
            } else if bare && event.text == Key.F11 {
                Commands.toggle-fullscreen();
            } else if bare && (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                if AppState.navigate { Commands.previous(); }
            } else if bare && (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                if AppState.navigate { Commands.next(); }
            } else if bare && event.text == Key.Home {
                if AppState.navigate { Commands.first(); }
            } else if bare && event.text == Key.End {
                if AppState.navigate { Commands.last(); }
            } else if plain && key == "+" {
                if img { Commands.zoom-in(); }
            } else if plain && key == "-" {
                if img { Commands.zoom-out(); }
            } else {
                return reject;
            }
            return accept;
        }

        VerticalLayout {
            if !AppState.fullscreen: TitleBar {
                height: root.title-bar-height;
                title-text: root.title-text;
            }
            // Content row.
            image-view := ImageView {
                vertical-stretch: 1;
                source: root.view-source;
                img-x: root.view-x;
                img-y: root.view-y;
                img-w: root.view-w;
                img-h: root.view-h;
                smooth: root.view-smooth;
                image-visible: !root.loading;
                wheel(delta, x, y) => {
                    root.view-wheel(delta, x, y);
                }
                drag(dx, dy) => {
                    root.view-drag(dx, dy);
                }
                resized => {
                    root.view-resized();
                }
                back => {
                    if AppState.navigate { Commands.previous(); }
                }
                forward => {
                    if AppState.navigate { Commands.next(); }
                }
                if root.loading: ProgressRing {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                // XAML IconSizeBar: floats bottom-centered, 16px clear of the edges, never wider than 640px.
                if AppState.icon-strip && !AppState.fullscreen: IconStrip {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 16px;
                    available: parent.width - 32px;
                    sizes: root.icon-sizes;
                    selected: root.icon-index;
                    reveal-offset(current, index, count, pitch, viewport) => {
                        return root.icon-reveal-offset(current, index, count, pitch, viewport);
                    }
                    choose(i) => {
                        root.icon-size-chosen(i);
                    }
                    step(d) => {
                        root.icon-size-step(d);
                    }
                }
                if root.cropping: Cropper {
                    width: parent.width;
                    height: parent.height;
                    img-x: root.view-x;
                    img-y: root.view-y;
                    img-w: root.view-w;
                    img-h: root.view-h;
                    image-width: root.crop-image-width;
                    sel-x: root.crop-x;
                    sel-y: root.crop-y;
                    sel-w: root.crop-w;
                    sel-h: root.crop-h;
                    ratios: root.crop-ratios;
                    ratio-index <=> root.crop-ratio-index;
                    drag-start(h) => {
                        root.crop-drag-start(h);
                    }
                    drag-move(dx, dy) => {
                        root.crop-drag-move(dx, dy);
                    }
                    ratio-chosen(i) => {
                        root.crop-ratio-chosen(i);
                    }
                    reset => {
                        root.crop-reset();
                    }
                    cancel => {
                        root.crop-cancel();
                    }
                    apply => {
                        root.crop-apply();
                    }
                }
                // XAML GlobalErrorMessage (the Store link is not ported: JXL decodes without the Store codec).
                if root.error-visible: VerticalLayout {
                    alignment: center;
                    padding: 40px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { glyph: "\u{E91B}"; size: 128px; tint: Theme.text-disabled; }
                    }
                    Rectangle { height: 10px; }
                    Text {
                        text: root.error-file;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                    Rectangle { height: 5px; }
                    Text {
                        text: Tr.t("SYSTEM_LOADING_ERROR");
                        font-size: 12px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
                // XAML SplitView pane: overlays the right edge, slides in over the image.
                InfoPane {
                    // Animated as a fraction: animating x itself made the pane trail behind the edge while the window was resized.
                    property <float> shown: AppState.info-open ? 1 : 0;
                    animate shown { duration: 200ms; easing: ease-out; }
                    x: parent.width - self.width * self.shown;
                    y: 0px;
                    height: parent.height;
                    visible: self.x < parent.width;
                    info: root.info;
                    close => {
                        AppState.info-open = false;
                    }
                    folder-clicked => {
                        root.info-folder-clicked();
                    }
                }
            }
            if !AppState.fullscreen: Footer { }
        }

        error-dialog := ErrorDialog {
            open <=> root.error-open;
            message: root.error-message;
        }
        settings-dialog := SettingsDialog {
            open <=> root.settings-open;
        }
        about-dialog := AboutDialog {
            open <=> root.about-open;
        }
        if !AppState.fullscreen: CaptionButtons {
            x: parent.width - self.width;
            y: 0px;
            maximized: root.maximized;
            caption-hover: root.caption-hover;
            caption-pressed: root.caption-pressed;
        }
    }
}
