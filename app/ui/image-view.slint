import { Theme } from "theme.slint";

// The image area: the picture is placed by Rust (img-*), pointer input is reported back.
export component ImageView inherits Rectangle {
    in property <image> source;
    in property <length> img-x;
    in property <length> img-y;
    in property <length> img-w;
    in property <length> img-h;
    // Smooth below 400%, pixelated from 400%.
    in property <bool> smooth: true;
    // False while loading: the ring replaces the image (XAML Opacity 0).
    in property <bool> image-visible: true;
    // Wheel delta in 1/120 notches (WinUI MouseWheelDelta), cursor in this element's coordinates.
    callback wheel(float, length, length);
    callback drag(length, length);
    callback resized(length, length);
    callback back();
    callback forward();

    background: Theme.image-background;
    clip: true;

    property <bool> dragging;
    property <length> last-x;
    property <length> last-y;

    changed width => {
        root.resized(self.width, self.height);
    }
    changed height => {
        root.resized(self.width, self.height);
    }

    Image {
        x: root.img-x;
        y: root.img-y;
        width: root.img-w;
        height: root.img-h;
        source: root.source;
        visible: root.image-visible;
        image-fit: fill;
        image-rendering: root.smooth ? ImageRendering.smooth : ImageRendering.pixelated;
    }

    touch := TouchArea {
        mouse-cursor: root.dragging && root.img-w > 0px ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.dragging = true;
                    root.last-x = touch.mouse-x;
                    root.last-y = touch.mouse-y;
                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.dragging = false;
                }
            } else if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.back {
                    root.back();
                } else if event.button == PointerEventButton.forward {
                    root.forward();
                }
            }
        }
        moved => {
            if root.dragging {
                root.drag(touch.mouse-x - root.last-x, touch.mouse-y - root.last-y);
                root.last-x = touch.mouse-x;
                root.last-y = touch.mouse-y;
            }
        }
        scroll-event(event) => {
            root.wheel(event.delta-y / 1px * 2, touch.mouse-x, touch.mouse-y);
            EventResult.accept
        }
    }
}
